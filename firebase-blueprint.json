{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private user profile created automatically on first Google sign-in.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "maxLength": 200
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "email", "photoURL", "createdAt", "updatedAt"]
    },
    "FavoriteCreator": {
      "title": "FavoriteCreator",
      "description": "A creator saved to the user's cloud favorites.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "public_id": {
          "type": "string",
          "maxLength": 200
        },
        "service": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "indexed": {
          "type": "number"
        },
        "updated": {
          "type": "number"
        },
        "favorited": {
          "type": "number"
        },
        "ever_imported": {
          "type": "boolean"
        },
        "savedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "id", "name", "public_id", "service", "indexed", "updated", "favorited", "ever_imported", "savedAt"]
    },
    "FavoritePost": {
      "title": "FavoritePost",
      "description": "A publication saved to the user's cloud favorites.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "user": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "service": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "title": {
          "type": "string",
          "maxLength": 400
        },
        "substring": {
          "type": "string",
          "maxLength": 600
        },
        "published": {
          "type": "string",
          "maxLength": 64
        },
        "creator_name": {
          "type": "string",
          "maxLength": 200
        },
        "file_name": {
          "type": "string",
          "maxLength": 300
        },
        "file_path": {
          "type": "string",
          "maxLength": 500
        },
        "file_server": {
          "type": "string",
          "maxLength": 200
        },
        "attachments_count": {
          "type": "number"
        },
        "savedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "id",
        "user",
        "service",
        "title",
        "substring",
        "published",
        "creator_name",
        "file_name",
        "file_path",
        "file_server",
        "attachments_count",
        "savedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user account profile document created on first Google login."
    },
    "/users/{userId}/favoriteCreators/{favId}": {
      "schema": { "$ref": "#/entities/FavoriteCreator" },
      "description": "User's favorite creators collection synced across devices."
    },
    "/users/{userId}/favoritePosts/{favId}": {
      "schema": { "$ref": "#/entities/FavoritePost" },
      "description": "User's favorite publications collection synced across devices."
    }
  }
}
